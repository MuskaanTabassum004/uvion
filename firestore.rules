rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: allow read/write only if the user is authenticated (logged in)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Specific rule for the 'users' collection:
    // A user can only read or write their OWN profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Future rule for the 'farms' collection (for the Setup page):
    // A user can only create, read, or modify their own farm data
    match /farms/{farmId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
